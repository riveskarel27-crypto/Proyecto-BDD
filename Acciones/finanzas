import yfinance as yf
import pandas as pd

tickers = [
    "STT", "JPM", "BAC", "WFC", "C",
    "AXP", "USB", "PNC", "BK", "SCHW",
    "AIG", "MMC", "CB", "TRV", "AFL"
]

datos = []

for ticker in tickers:

    print("Descargando:", ticker)

    df = yf.download(
        ticker,
        start="1996-10-03",
        end="2026-10-03",
        interval="1d",
        auto_adjust=False,
        multi_level_index=False,
        progress=False
    )

    df = df.reset_index()
    df["Ticker"] = ticker

    datos.append(df)

precios = pd.concat(datos, ignore_index=True)

precios = precios[
    ["Date", "Ticker", "Open", "High", "Low",
     "Close", "Adj Close", "Volume"]
]

precios.columns = [
    "fecha",
    "ticker",
    "apertura",
    "maximo",
    "minimo",
    "cierre",
    "cierre_ajustado",
    "volumen"
]

precios.to_csv(
    "precios_financiero.csv",
    index=False
)

print("\nLISTO")
print(precios.head())
print("\nNúmero de registros:", len(precios))
