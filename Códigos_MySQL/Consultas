create database acciones;

# -----------------------------------------
# Indicamos que es la base que vamos a usar
# ----------------------------------------- 
use acciones;

# -----------------------------------------
# Creamos las tablas
# ----------------------------------------- 

CREATE TABLE financiero (
  fecha DATE,
  ticker VARCHAR(10),
  apertura DOUBLE, maximo DOUBLE,
  minimo DOUBLE, 
  cierre DOUBLE,
  cierre_ajustado DOUBLE,
  volumen BIGINT
);

CREATE TABLE industrial (
  fecha DATE,
  ticker VARCHAR(10),
  apertura DOUBLE, maximo DOUBLE,
  minimo DOUBLE, 
  cierre DOUBLE,
  cierre_ajustado DOUBLE,
  volumen BIGINT
);
CREATE TABLE salud (
  fecha DATE,
  ticker VARCHAR(10),
  apertura DOUBLE, maximo DOUBLE,
  minimo DOUBLE, 
  cierre DOUBLE,
  cierre_ajustado DOUBLE,
  volumen BIGINT
);
CREATE TABLE consumo (
  fecha DATE,
  ticker VARCHAR(10),
  apertura DOUBLE, maximo DOUBLE,
  minimo DOUBLE, 
  cierre DOUBLE,
  cierre_ajustado DOUBLE,
  volumen BIGINT
);


