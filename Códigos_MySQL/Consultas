#####################################################
# Análisis de acciones
#####################################################

# ------------------------------------------------------
# Creamos la base de datos en la que estamos trabajando 
# ------------------------------------------------------
create database acciones;

# -----------------------------------------
# Indicamos que es la base que vamos a usar
# ----------------------------------------- 
use acciones;

# -----------------------------
# Vemos los datos de cada tabla
# ----------------------------- 
select * from financiero;
select * from salud;
select * from consumo;
select * from industrial;

# ---------------------------------------------------------------
# Modificamos la columna de fecha para que se guarden como fechas
# ---------------------------------------------------------------
ALTER TABLE financiero MODIFY fecha DATE;
ALTER TABLE salud MODIFY fecha DATE;
ALTER TABLE consumo MODIFY fecha DATE;
ALTER TABLE industrial MODIFY fecha DATE;

# ----------------
# Primer consulta 
# ----------------
SELECT 
	f.fecha, 
	ROUND(f.cierre, 2) AS Financiero_Close, 
	ROUND(s.cierre, 2) AS Salud_Close, 
	ROUND(c.cierre, 2) AS Consumo_Close, 
	ROUND(i.cierre, 2) AS Industrial_Close
FROM (SELECT fecha, AVG(cierre) AS cierre FROM financiero GROUP BY fecha) f
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM salud GROUP BY fecha) s ON f.fecha = s.fecha
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM consumo GROUP BY fecha) c ON f.fecha = c.fecha
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM industrial GROUP BY fecha) i ON f.fecha = i.fecha
WHERE f.fecha BETWEEN '2024-01-01' AND '2024-12-31'
ORDER BY f.fecha ASC;

# -----------------
# Segunda consulta
# -----------------

SELECT 
    DATE_FORMAT(f.fecha, '%Y-%m') AS Mes,
    ROUND(AVG(f.cierre), 2) AS Financiero_Avg,
    ROUND(AVG(s.cierre), 2) AS Salud_Avg,
    ROUND(AVG(c.cierre), 2) AS Consumo_Avg,
    ROUND(AVG(i.cierre), 2) AS Industrial_Avg
FROM (SELECT fecha, AVG(cierre) AS cierre FROM financiero GROUP BY fecha) f
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM salud GROUP BY fecha) s ON f.fecha = s.fecha
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM consumo GROUP BY fecha) c ON f.fecha = c.fecha
INNER JOIN (SELECT fecha, AVG(cierre) AS cierre FROM industrial GROUP BY fecha) i ON f.fecha = i.fecha
GROUP BY DATE_FORMAT(f.fecha, '%Y-%m')
ORDER BY Mes ASC;

# -----------------
# tercera consulta
# -----------------
SELECT 'Financiero' AS Sector, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM financiero
UNION ALL
SELECT 'Salud' AS Sector, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM salud
UNION ALL
SELECT 'Consumo' AS Sector, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM consumo
UNION ALL
SELECT 'Industrial' AS Sector, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM industrial;
