IGNORE 1 LINES;


# ----------------------------
# Vemos los datos de cada tabla
# ----------------------------- 
select * from financiero;
select * from salud;
select * from consumo;
select * from industrial;

# ----------------
# Primera consulta 
# ----------------
SELECT 
	f.fecha, 
	ROUND(i.cierre, 2) AS LMT_Close, 
	ROUND(s.cierre, 2) AS BMY_Close, 
	ROUND(f.cierre, 2) AS STT_Close,
	ROUND(c.cierre, 2) AS KO_Close
FROM financiero f
LEFT JOIN industrial i ON f.fecha = i.fecha AND i.ticker = 'LMT'
LEFT JOIN salud s ON f.fecha = s.fecha AND s.ticker = 'BMY'
LEFT JOIN consumo c ON f.fecha = c.fecha AND c.ticker = 'KO'
WHERE f.ticker = 'STT'
  AND f.fecha BETWEEN '2024-01-01' AND '2024-12-31'
ORDER BY f.fecha ASC;

# -----------------
# Segunda consulta
# -----------------

SELECT 
    DATE_FORMAT(f.fecha, '%Y-%m') AS Mes,
    ROUND(AVG(i.cierre), 2) AS LMT_Avg,
    ROUND(AVG(s.cierre), 2) AS BMY_Avg,
    ROUND(AVG(f.cierre), 2) AS STT_Avg,
    ROUND(AVG(c.cierre), 2) AS KO_Avg
FROM financiero f
LEFT JOIN industrial i ON f.fecha = i.fecha AND i.ticker = 'LMT'
LEFT JOIN salud s ON f.fecha = s.fecha AND s.ticker = 'BMY'
LEFT JOIN consumo c ON f.fecha = c.fecha AND c.ticker = 'KO'
WHERE f.ticker = 'STT'
GROUP BY DATE_FORMAT(f.fecha, '%Y-%m')
ORDER BY Mes ASC;
# -----------------
# tercera consulta
# -----------------
SELECT 'LMT' AS Ticker, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM industrial WHERE ticker = 'LMT'
UNION ALL
SELECT 'BMY' AS Ticker, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM salud WHERE ticker = 'BMY'
UNION ALL
SELECT 'STT' AS Ticker, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM financiero WHERE ticker = 'STT'
UNION ALL
SELECT 'KO' AS Ticker, MIN(minimo) AS Minimo, MAX(maximo) AS Maximo, AVG(volumen) AS Vol_Promedio FROM consumo WHERE ticker = 'KO';
